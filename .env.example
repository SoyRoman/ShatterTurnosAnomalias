# Plantilla de configuración. Copia este archivo a `.env` y pon ahí los
# valores reales:  cp .env.example .env
#
# `.env` está en .gitignore y NO debe versionarse nunca.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=turnos
DB_USER=turnos_app
DB_PASSWORD=cambia_esto
DB_SSLMODE=prefer

# Token compartido que exige la API en la cabecera X-API-Token.
# Si lo dejas vacío, la API arranca SIN autenticación y lo avisa por consola:
# solo aceptable en una red interna cerrada.
# Autentica al SISTEMA que llama (el dashboard), no a la PERSONA.
API_TOKEN=

# ---------------------------------------------------------------------------
# Quién es la PERSONA que gestiona una anomalía
# ---------------------------------------------------------------------------
# DECLARATIVA  El navegador dice quién es en X-Usuario y se le cree. Es el
#              comportamiento histórico y solo sirve en red interna cerrada.
# PROXY        La identidad la pone un proxy que YA autenticó a la persona
#              (Cloudflare Access, ALB+Cognito, el login de la empresa) en una
#              cabecera que el cliente no controla. X-Usuario se ignora.
#
# Esto no es un detalle de comodidad: `anomalias_historial` puede terminar
# sustentando una respuesta ante el Ministerio del Trabajo. Con identidad
# declarativa expuesta, cualquiera podría marcar una anomalía como JUSTIFICADA
# firmando con el nombre de otro.
#
# **No pongas esto en producción con DECLARATIVA.**
MODO_IDENTIDAD=DECLARATIVA

# Solo se usa con MODO_IDENTIDAD=PROXY: de qué cabecera se lee la identidad ya
# verificada. Cloudflare Access -> Cf-Access-Authenticated-User-Email
# ALB + Cognito                 -> x-amzn-oidc-identity
CABECERA_IDENTIDAD=Cf-Access-Authenticated-User-Email

# Dirección donde docker-compose publica la API. Por defecto solo loopback,
# para forzar que haya un proxy autenticador delante. Ponerlo en 0.0.0.0 la
# expone a la red — solo con MODO_IDENTIDAD=PROXY, o en red interna cerrada.
API_BIND=127.0.0.1

# Token del túnel de Cloudflare, solo en el servidor (perfil `produccion` de
# docker-compose). Es una credencial: no la pongas en ningún comando ni en el
# repo. Ver despliegue/CLOUDFLARE.md.
CLOUDFLARE_TUNNEL_TOKEN=

# Solo para descargar_malla_serpi.py: login WEB de SERPI (no confundir con
# el token/secretkey de la API general del ERP, son cosas distintas).
# Cambia la clave de este usuario en SERPI por una fuerte antes de dejarlo
# corriendo desatendido a diario.
SERPI_WEB_USER=
SERPI_WEB_PASSWORD=
