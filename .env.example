# Plantilla de configuración. Copia este archivo a `.env` y pon ahí los
# valores reales:  cp .env.example .env
#
# `.env` está en .gitignore y NO debe versionarse nunca.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=turnos
DB_USER=turnos_app
DB_PASSWORD=cambia_esto
DB_SSLMODE=prefer

# Token compartido que exige la API en la cabecera X-API-Token.
# Si lo dejas vacío, la API arranca SIN autenticación y lo avisa por consola:
# solo aceptable en una red interna cerrada.
API_TOKEN=
