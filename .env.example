# Plantilla de configuración. Copia este archivo a `.env` y pon ahí los
# valores reales:  cp .env.example .env
#
# `.env` está en .gitignore y NO debe versionarse nunca.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=turnos
DB_USER=turnos_app
DB_PASSWORD=cambia_esto
DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Login y sesiones
# ---------------------------------------------------------------------------
# SESION       (default) Login propio: usuarios, claves y sesiones viven en esta
#              misma base. NINGUNA ruta responde sin sesion, ni siquiera /docs.
#              Las cuentas las crea un ADMIN (dashboard o gestionar_usuarios.py).
# DECLARATIVA  Sin login: se cree la cabecera X-Usuario. Solo desarrollo local;
#              en este modo la API queda abierta a quien alcance el puerto.
MODO_IDENTIDAD=SESION

# Duracion de la sesion. 12 h cubre una jornada sin obligar a reingresar a media
# tarde, y no deja una sesion viva toda la noche en un equipo compartido.
HORAS_SESION=12

# Intentos fallidos antes de bloquear la cuenta, y por cuantos minutos.
# Se cuenta por CUENTA y no por IP: en la oficina todos salen por la misma NAT,
# asi que bloquear por IP dejaria fuera a todos por culpa de uno.
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO_LOGIN=15

# La cookie de sesion exige HTTPS. **En el servidor NUNCA lo pongas en 0**: sin
# esto la cookie viaja en claro y cualquiera en la red la puede copiar. Solo se
# apaga para desarrollo local por HTTP.
COOKIE_SEGURA=1

# Direccion donde docker-compose publica la API. Loopback por defecto, para que
# delante vaya un proxy que termine TLS.
API_BIND=127.0.0.1

# Token compartido OPCIONAL para integraciones que no son un navegador. Se
# exige en la cabecera X-API-Token. Autentica al SISTEMA que llama, no a la
# PERSONA: no sustituye al login.
API_TOKEN=

# Solo para descargar_malla_serpi.py: login WEB de SERPI (no confundir con
# el token/secretkey de la API general del ERP, son cosas distintas).
# Cambia la clave de este usuario en SERPI por una fuerte antes de dejarlo
# corriendo desatendido a diario.
SERPI_WEB_USER=
SERPI_WEB_PASSWORD=
